# Absolute host directory mounted at /shared.
SHARED_PATH=/absolute/path/to/shared

# Public HTTPS base URL used by the MCP client.
MCP_PUBLIC_URL=https://your-domain.example

# Optional settings.
TZ=UTC
# WORKMACHINE_IMAGE=workmachine:local
# MCP_ALLOWED_HOSTS=
# MCP_OAUTH_APPROVAL_KEY=
# MCP_AUTH_TOKEN=

# Windows Runner queue inside the Docker container.
# StartMCP.cjs mounts the Windows host runtime directory here.
WINDOWS_RUNNER_QUEUE_DIR=/chatlocalwork-runtime/windows-runner
# WINDOWS_RUNNER_TIMEOUT_MS=120000

# Host directory for persistent MCP access diagnostics.
# StartMCP.cjs sets this automatically in normal use.
# CHATLOCALWORK_DIAGNOSTICS_HOST_DIR=C:\\Users\\<user>\\AppData\\Local\\ChatLocalWork\\runtime\\diagnostics\\mcp-access
